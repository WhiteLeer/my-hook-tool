<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(SmolvSourceDir)/*.cs" Link="Smolv/%(Filename)%(Extension)" />
  </ItemGroup>
  <Target Name="RequireDecoder" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(SmolvSourceDir)/SmolvDecoder.cs')" Text="Pass -p:SmolvSourceDir=the existing AnimeStudio.Utility/Smolv directory." />
  </Target>
</Project>
